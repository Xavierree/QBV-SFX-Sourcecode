# Copy to .env.local (never commit .env.local: it holds secrets). Read by `next start` at start-up;
# NEXT_PUBLIC_* values are read at build time, so rebuild after changing them.

# The FastAPI backend on THIS machine (port 8500, localhost only).
INFERENCE_URL=http://127.0.0.1:8500

# Optional passcode gate. Leave QBV_PASSCODE empty and the app is open at http://localhost:3000.
# If you set a passcode, also set QBV_GATE_SECRET (generate once with: openssl rand -hex 32).
QBV_PASSCODE=
QBV_GATE_SECRET=

# Metadata step of the Submit page (title, tags, description), through OmniRoute (manual, chapter 2.4).
# If these are unset, a submitted clip is still embedded and searchable; only the metadata step is skipped.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Only if you serve the app under a sub-path (e.g. /qbv). Empty = served at the root.
NEXT_PUBLIC_BASE_PATH=
